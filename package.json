{
  "name": "gdgoc-cnu-page",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:domain": "node --test --experimental-strip-types \"src/domain/**/*.test.ts\"",
    "test:rules": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "test:rules:emulator": "firebase emulators:exec --project demo-gdgoc-cnu --only firestore \"npm run test:rules\"",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "next build"
  },
  "dependencies": {
    "@wanteddev/wds": "^3.6.0",
    "@wanteddev/wds-icon": "^3.6.0",
    "@wanteddev/wds-nextjs": "^3.6.0",
    "firebase": "^12.13.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "firebase-tools": "^14.21.0",
    "typescript": "^6.0.3"
  }
}
